": true, "raw_text": "χ²(8) = 2.65, p = 0.98", "textual_interpretation": "suggesting that educational background did not meaningfully predict engagement in these online resources", "interpretation_direction": "not_significant", "consistent": true, "notes": "Chi-square test of independence examining the relationship between educational attainment and support community participation", "interpretations": [{"section": "results", "sentence": "The distribution of support community participation was not significantly associated with educational level, χ²(8) = 2.65, p = 0.98, suggesting that educational background did not meaningfully predict engagement in these online resources.", "keywords": ["not significantly associated", "did not meaningfully predict"], "direction": "not_significant", "effect_strength": "none", "hedging": false, "claim": "The distribution of support community participation was not significantly associated with educational level, suggesting that educational background did not meaningfully predict engagement in these online resources."}, {"section": "results", "sentence": "The non-significant relationship between education and engagement may indicate that online support communities serve as accessible resources across diverse educational backgrounds, whereas psychological factors like anxiety more directly motivate help-seeking behavior.", "keywords": ["non-significant relationship"], "direction": "not_significant", "effect_strength": "none", "hedging": true, "claim": "The non-significant relationship between education and engagement may indicate that online support communities serve as accessible resources across diverse educational backgrounds."}], "primary_direction": "not_significant", "has_cross_section_conflict": false, "any_hedging": true, "sections": ["results", "results"]}], "verified_tests": [{"test_type": "t", "statistic_value": 3.13, "df1": 199.0, "df2": null, "reported_p": 0.002, "p_equality": "=", "two_tailed": true, "raw_text": "t(199) = 3