{"example_id": "dev-syn-190", "source": "synthetic", "source_id": "288", "extractor": "openrouter-deepseek", "verifier": "openrouter-gemini", "model": "openrouter-deepseek->openrouter-gemini", "experiment": "cross_verify_unidir", "markdown_stats": {"n_pages": null, "n_tables": null, "markdown_len": 2109}, "n_gold_tests": 1, "n_predicted_tests": 1, "sections_found": ["preamble", "results"], "summarization_stats": {"applied": false, "skip_reason": "flag_off"}, "cross_verify_diagnostics": {"n_proposed": 2, "n_verified": 1, "n_corrected": 0, "n_removed": 1, "n_unmentioned": 0, "n_added": 0, "n_final": 1}, "cross_verify_records": {"verified_records": [{"original_id": 0, "status": "correct", "evidence_quote": "The omnibus test for residual heterogeneity revealed no significant heterogeneity beyond what would be expected from sampling variation, df = 19, Q = 32.1, p = 0.55."}], "removed_records": [{"original_id": 1, "reason": "Value 0.18 appears in text as a mean effect size (r), not a test statistic with associated p-value.", "original_test": {"test_type": "r", "statistic_value": 0.18, "df1": null, "df2": null, "reported_p": null, "p_equality": null, "two_tailed": true, "raw_text": "We estimated the mean effect size across all studies at r = 0.18 (95% CI: 0.12 to 0.24), suggesting a small to moderate positive association between dividend payout ratios and firm market-to-book ratios.", "textual_interpretation": "suggesting a small to moderate positive association between dividend payout ratios and firm market-to-book ratios.", "interpretation_direction": "significant", "consistent": true, "notes": "Mean effect size across all studies"}}], "added_records": [], "unmentioned_ids": []}, "predicted_tests": [{"test_type": "Q", "statistic_value": 32.1, "df1": 19.0, "df2": null, "reported_p": 0.55, "p_equality": "=", "two_tailed": true, "raw_text": "The omnibus test for residual heterogeneity revealed no significant heterogeneity beyond what would be expected from sampling variation, df = 19, Q = 32.1, p = 0.55.", "textual_interpretation": "This result was not statistically significant, indicating that the included studies were reasonably homogeneous in their findings regarding the dividend-valuation relationship.", "interpretation_direction": "not_significant", "consistent": true, "notes": "Omnibus test for residual heterogeneity"}], "merged_tests": [{"test_type": "Q", "statistic_value": 32.1, "df1": 19.0, "df2": null, "reported_p": 0.55, "p_equality": "=", "two_tailed": true, "raw_text": "The omnibus test for residual heterogeneity revealed no significant heterogeneity beyond what would be expected from sampling variation, df = 19, Q = 32.1, p = 0.55.", "textual_interpretation": "This result was not statistically significant, indicating that the included studies were reasonably homogeneous in their findings regarding the dividend-valuation relationship.", "interpretation_direction": "not_significant", "consistent": true, "notes": "Omnibus test for residual heterogeneity", "interpretations": [{"section": "results", "sentence": "The omnibus test for residual heterogeneity revealed no significant heterogeneity beyond what would be expected from sampling variation, df = 19, Q = 32.1, p = 0.55. This result was not statistically significant, indicating that the included studies were reasonably homogeneous in their findings regarding the dividend-valuation relationship. Consequently, the assumption that studies shared a common underlying effect was not violated, supporting the validity of our pooled estimate.", "keywords": ["no significant heterogeneity", "not statistically significant", "reasonably homogeneous", "not violated", "supporting the validity"], "direction": "not_significant", "effect_strength": "none", "hedging": false, "claim": "The omnibus test for residual heterogeneity showed no significant heterogeneity, indicating that the included studies were reasonably homogeneous and the assumption of a common underlying effect was not violated, supporting the validity of the pooled estimate."}], "primary_direction": "not_significant", "has_cross_section_conflict": false, "any_hedging": false, "sections": ["results"]}], "verified_tests": [{"test_type": "Q", "statistic_value": 32.1, "df1": 19.0, "df2": null, "reported_p": 0.55, "p_equality": "=", "two_tailed": true, "raw_text": "The omnibus test for residual heterogeneity revealed no significant heterogeneity beyond what would be expected from sampling variation, df = 19, Q = 32.1, p = 0.55.", "textual_interpretation": "This result was not statistically significant, indicating that the included studies were reasonably homogeneous in their findings regarding the dividend-valuation relationship.", "interpretation_direction": "not_significant", "consistent": true, "notes": "Omnibus test for residual heterogeneity", "interpretations": [{"section": "results", "sentence": "The omnibus test for residual heterogeneity revealed no significant heterogeneity beyond what would be expected from sampling variation, df = 19, Q = 32.1, p = 0.55. This result was not statistically significant, indicating that the included studies were reasonably homogeneous in their findings regarding the dividend-valuation relationship. Consequently, the assumption that studies shared a common underlying effect was not violated, supporting the validity of our pooled estimate.", "keywords": ["no significant heterogeneity", "not statistically significant", "reasonably homogeneous", "not violated", "supporting the validity"], "direction": "not_significant", "effect_strength": "none", "hedging": false, "claim": "The omnibus test for residual heterogeneity showed no significant heterogeneity, indicating that the included studies were reasonably homogeneous and the assumption of a common underlying effect was not violated, supporting the validity of the pooled estimate."}], "primary_direction": "not_significant", "has_cross_section_conflict": false, "any_hedging": false, "sections": ["results"], "computed_p": 0.0304537858, "p_consistency": "inconsistent", "interpretation_consistency": "inconsistent"}], "error": null, "stage1": null, "stage3": {"tp": 1, "fp": 0, "fn": 0, "precision": 1.0, "recall": 1.0, "f1": 1.0, "field_accuracy": 1.0, "complete_extraction_rate": 1.0, "hallucination_rate": 0.0, "pairs": [[0, 0]], "fp_classifications": []}, "stage4": {"primary_direction_accuracy": 1.0, "found_interpretation_rate": 1.0, "matched_pairs": 1, "direction_total": 1, "direction_hits": 1}, "stage5": {"tpv": 1, "fpv": 0, "fnv": 0, "not_checkable": 0, "tpv_combined": 1, "fpv_combined": 0, "fnv_combined": 0, "not_checkable_combined": 0}}
