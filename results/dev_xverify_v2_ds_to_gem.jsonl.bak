{"example_id": "dev-syn-021", "source": "synthetic", "source_id": "318", "extractor": "openrouter-deepseek", "verifier": "openrouter-gemini", "model": "openrouter-deepseek->openrouter-gemini", "experiment": "cross_verify_unidir", "markdown_stats": {"n_pages": null, "n_tables": null, "markdown_len": 2121}, "n_gold_tests": 1, "n_predicted_tests": 1, "sections_found": ["preamble", "results"], "summarization_stats": {"applied": false, "skip_reason": "flag_off"}, "cross_verify_diagnostics": {"n_proposed": 1, "n_verified": 1, "n_corrected": 0, "n_removed": 0, "n_unmentioned": 0, "n_added": 0, "n_final": 1}, "cross_verify_records": {"verified_records": [{"original_id": 0, "status": "correct", "evidence_quote": "A Pearson correlation analysis revealed a weak positive relationship between CSR expenditure ratios and subsequent firm profitability, r(98) = 0.36, p = 0.0."}], "removed_records": [], "added_records": [], "unmentioned_ids": []}, "predicted_tests": [{"test_type": "r", "statistic_value": 0.36, "df1": 98.0, "df2": null, "reported_p": 0.0, "p_equality": "=", "two_tailed": true, "raw_text": "r(98) = 0.36, p = 0.0", "textual_interpretation": "This result was statistically significant at conventional significance levels, indicating that firms allocating greater resources to CSR activities tend to experience modestly higher returns on assets in the following year.", "interpretation_direction": "significant", "consistent": true, "notes": "Pearson correlation analysis between CSR expenditure ratios and subsequent firm profitability."}], "merged_tests": [{"test_type": "r", "statistic_value": 0.36, "df1": 98.0, "df2": null, "reported_p": 0.0, "p_equality": "=", "two_tailed": true, "raw_text": "r(98) = 0.36, p = 0.0", "textual_interpretation": "This result was statistically significant at conventional significance levels, indicating that firms allocating greater resources to CSR activities tend to experience modestly higher returns on assets in the following year.", "interpreta