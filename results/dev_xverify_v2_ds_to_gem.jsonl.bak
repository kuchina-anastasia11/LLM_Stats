{"example_id": "dev-syn-109", "source": "synthetic", "source_id": "325", "extractor": "openrouter-deepseek", "verifier": "openrouter-gemini", "model": "openrouter-deepseek->openrouter-gemini", "experiment": "cross_verify_unidir", "markdown_stats": {"n_pages": null, "n_tables": null, "markdown_len": 2005}, "n_gold_tests": 2, "n_predicted_tests": 2, "sections_found": ["preamble", "results"], "summarization_stats": {"applied": false, "skip_reason": "flag_off"}, "cross_verify_diagnostics": {"n_proposed": 2, "n_verified": 2, "n_corrected": 0, "n_removed": 0, "n_unmentioned": 0, "n_added": 0, "n_final": 2}, "cross_verify_records": {"verified_records": [{"original_id": 0, "status": "correct", "evidence_quote": "The Mann-Whitney U test comparing joint space narrowing scores between high and low baseline CRP groups yielded a standardized Z statistic of -3.25 with a one-tailed p-value of 0.284."}, {"original_id": 1, "status": "correct", "evidence_quote": "| TNF-α inhibitor efficacy (disease subtypes) | Cochran's Q | 7.69 | 20 | 0.998 |"}], "removed_records": [], "added_records": [], "unmentioned_ids": []}, "predicted_tests": [{"test_type": "z", "statistic_value": -3.25, "df1": null, "df2": null, "reported_p": 0.284, "p_equality": "=", "two_tailed": false, "raw_text": "The Mann-Whitney U test comparing joint space narrowing scores between high and low baseline CRP groups yielded a standardized Z statistic of -3.25 with a one-tailed p-value of 0.284.", "textual_interpretation": "This result was not statistically significant, indicating that baseline CRP elevation did not demonstrate a significant directional association with accelerated joint space narrowing in our cohort.", "interpretation_direction": "not_significant", "consistent": true, "notes": "One-tailed hypothesis test."}, {"test_type": "Q", "statistic_value": 7.69, "df1": 20.0, "df2": null, "reported_p": 0.998, "p_equality": "=", "two_tailed": true, "raw_text": "| TNF-α inhibitor efficacy (disease subtypes) | Cochran's