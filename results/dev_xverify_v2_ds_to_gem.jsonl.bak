{"example_id": "dev-syn-003", "source": "synthetic", "source_id": "103", "extractor": "openrouter-deepseek", "verifier": "openrouter-gemini", "model": "openrouter-deepseek->openrouter-gemini", "experiment": "cross_verify_unidir", "markdown_stats": {"n_pages": null, "n_tables": null, "markdown_len": 1884}, "n_gold_tests": 3, "n_predicted_tests": 4, "sections_found": ["preamble", "results"], "summarization_stats": {"applied": false, "skip_reason": "flag_off"}, "cross_verify_diagnostics": {"n_proposed": 4, "n_verified": 4, "n_corrected": 0, "n_removed": 0, "n_unmentioned": 0, "n_added": 0, "n_final": 4}, "cross_verify_records": {"verified_records": [{"original_id": 0, "status": "correct", "evidence_quote": "no significant differences between groups, χ²(10) = 0.56, p = 1.0, indicating successful randomization."}, {"original_id": 1, "status": "correct", "evidence_quote": "in the control group (n = 27/71), χ²(1) = 26.74, p = 0.02, representing a clinically meaningful and statistically significant improvement in disease outcomes."}, {"original_id": 2, "status": "correct", "evidence_quote": "we obtained Z = 3.2, p = 0.01 (one-tailed), confirming a statistically significant reduction in systemic inflammation favoring the intervention group."}, {"original_id": 3, "status": "correct", "evidence_quote": "This biomarker improvement correlated strongly with clinical remission status (r = 0.71, p < 0.001)."}], "removed_records": [], "added_records": [], "unmentioned_ids": []}, "predicted_tests": [{"test_type": "chi", "statistic_value": 0.56, "df1": 10.0, "df2": null, "reported_p": 1.0, "p_equality": "=", "two_tailed": true, "raw_text": "χ²(10) = 0.56, p = 1.0", "textual_interpretation": "no significant differences between groups", "interpretation_direction": "not_significant", "consistent": true, "notes": "Analysis of categorical variables including sex distribution, smoking status, and prior medication use"}, {"test_type": "chi", "statistic_value": 26.74, "df1": 1.0, "df2": null,