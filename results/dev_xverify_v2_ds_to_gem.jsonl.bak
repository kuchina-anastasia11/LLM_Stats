 sectors", "interpretation_direction": "not_significant", "consistent": true, "notes": "meta-analytic homogeneity test across 16 industry classifications"}], "merged_tests": [{"test_type": "t", "statistic_value": -3.06, "df1": 283.0, "df2": null, "reported_p": 0.01, "p_equality": "<", "two_tailed": true, "raw_text": "t(283) = -3.06, p < 0.01", "textual_interpretation": "the difference in mean ROA between the two groups was statistically significant at the 1% level", "interpretation_direction": "significant", "consistent": true, "notes": "independent samples t-test comparing mean ROA between highly leveraged firms and moderately leveraged firms (sample size = 284)", "interpretations": [{"section": "results", "sentence": "The highly leveraged group demonstrated significantly lower profitability, with t(283) = -3.06, p < 0.01, indicating that the difference in mean ROA between the two groups was statistically significant at the 1% level.", "keywords": ["significantly lower", "statistically significant"], "direction": "significant", "effect_strength": "unclear", "hedging": false, "claim": "The highly leveraged group demonstrated significantly lower profitability, and the difference in mean ROA between the two groups was statistically significant."}, {"section": "results", "sentence": "Specifically, highly leveraged firms exhibited an average ROA of 4.2%, compared to 6.8% for moderately leveraged firms, suggesting that excessive leverage substantially impairs operational efficiency.", "keywords": ["substantially impairs"], "direction": "significant", "effect_strength": "strong", "hedging": false, "claim": "Excessive leverage substantially impairs operational efficiency, as highly leveraged firms had a lower average ROA."}], "primary_direction": "significant", "has_cross_section_conflict": false, "any_hedging": false, "sections": ["results", "results"]}, {"test_type": "Q", "statistic_value": 45.33, "df1": 15.0, "df2": null, "reported_p": 0.337, "p_equality": "=", "two_tai