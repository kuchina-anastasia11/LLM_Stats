{"example_id": "dev-syn-222", "source": "synthetic", "source_id": "260", "extractor": "openrouter-deepseek", "verifier": "openrouter-gemini", "model": "openrouter-deepseek->openrouter-gemini", "experiment": "cross_verify_unidir", "markdown_stats": {"n_pages": null, "n_tables": null, "markdown_len": 2169}, "n_gold_tests": 1, "n_predicted_tests": 1, "sections_found": ["preamble", "results"], "summarization_stats": {"applied": false, "skip_reason": "flag_off"}, "cross_verify_diagnostics": {"n_proposed": 3, "n_verified": 1, "n_corrected": 0, "n_removed": 2, "n_unmentioned": 0, "n_added": 0, "n_final": 1}, "cross_verify_records": {"verified_records": [{"original_id": 0, "status": "correct", "evidence_quote": "Our sample comprised 58 publicly traded firms (n = 58) with complete data on board composition, executive compensation structures, and three-year average return on assets (ROA).\n\nThe ANOVA revealed substantial variation in mean ROA across industry groups, F(7, 50) = 19.77, p = .0. These results suggest that industry classification alone does not substantially explain differences in financial performance, indicating that firm-specific governance mechanisms may play a more nuanced role than previously theorized. While the F-statistic was notably elevated, the heterogeneity observed across sectors appears attributable to idiosyncratic factors rather than systematic industry effects."}], "removed_records": [{"original_id": 1, "reason": "Value 0.18 is part of a range of correlations, not a single test statistic.", "original_test": {"test_type": "r", "statistic_value": 0.18, "df1": null, "df2": null, "reported_p": null, "p_equality": null, "two_tailed": true, "raw_text": "r = .18 to .34", "textual_interpretation": "These variables demonstrated modest correlations with ROA, suggesting that the observed performance differentials may reflect broader economic conditions affecting specific sectors during the study period (2018-2022) rather than structural governance differences.", "interpretation_direction": "unclear", "consistent": null, "notes": "Correlation analysis with ROA"}}, {"original_id": 2, "reason": "Value 0.34 is part of a range of correlations, not a single test statistic.", "original_test": {"test_type": "r", "statistic_value": 0.34, "df1": null, "df2": null, "reported_p": null, "p_equality": null, "two_tailed": true, "raw_text": "r = .18 to .34", "textual_interpretation": "These variables demonstrated modest correlations with ROA, suggesting that the observed performance differentials may reflect broader economic conditions affecting specific sectors during the study period (2018-2022) rather than structural governance differences.", "interpretation_direction": "unclear", "consistent": null, "notes": "Correlation analysis with ROA"}}], "added_records": [], "unmentioned_ids": []}, "predicted_tests": [{"test_type": "F", "statistic_value": 19.77, "df1": 7.0, "df2": 50.0, "reported_p": 0.0, "p_equality": "=", "two_tailed": true, "raw_text": "F(7, 50) = 19.77, p = .0", "textual_interpretation": "These results suggest that industry classification alone does not substantially explain differences in financial performance, indicating that firm-specific governance mechanisms may play a more nuanced role than previously theorized.", "interpretation_direction": "significant", "consistent": true, "notes": "ANOVA test with n = 58 firms"}], "merged_tests": [{"test_type": "F", "statistic_value": 19.77, "df1": 7.0, "df2": 50.0, "reported_p": 0.0, "p_equality": "=", "two_tailed": true, "raw_text": "F(7, 50) = 19.77, p = .0", "textual_interpretation": "These results suggest that industry classification alone does not substantially explain differences in financial performance, indicating that firm-specific governance mechanisms may play a more nuanced role than previously theorized.", "interpretation_direction": "significant", "consistent": true, "notes": "ANOVA test with n = 58 firms", "interpretations": [{"section": "results", "sentence": "The ANOVA revealed substantial variation in mean ROA across industry groups, F(7, 50) = 19.77, p = .0. These results suggest that industry classification alone does not substantially explain differences in financial performance, indicating that firm-specific governance mechanisms may play a more nuanced role than previously theorized. While the F-statistic was notably elevated, the heterogeneity observed across sectors appears attributable to idiosyncratic factors rather than systematic industry effects.", "keywords": ["substantial variation", "does not substantially explain", "notably elevated", "appears attributable"], "direction": "significant", "effect_strength": "unclear", "hedging": true, "claim": "The ANOVA showed significant variation in mean ROA across industry groups, but this variation is not primarily explained by industry classification alone, suggesting that firm-specific governance mechanisms are more important and that the observed heterogeneity is due to idiosyncratic factors."}], "primary_direction": "significant", "has_cross_section_conflict": false, "any_hedging": true, "sections": ["results"]}], "verified_tests": [{"test_type": "F", "statistic_value": 19.77, "df1": 7.0, "df2": 50.0, "reported_p": 0.0, "p_equality": "=", "two_tailed": true, "raw_text": "F(7, 50) = 19.77, p = .0", "textual_interpretation": "These results suggest that industry classification alone does not substantially explain differences in financial performance, indicating that firm-specific governance mechanisms may play a more nuanced role than previously theorized.", "interpretation_direction": "significant", "consistent": true, "notes": "ANOVA test with n = 58 firms", "interpretations": [{"section": "results", "sentence": "The ANOVA revealed substantial variation in mean ROA across industry groups, F(7, 50) = 19.77, p = .0. These results suggest that industry classification alone does not substantially explain differences in financial performance, indicating that firm-spec