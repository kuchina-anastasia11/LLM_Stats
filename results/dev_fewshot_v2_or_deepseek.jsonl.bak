{"example_id": "dev-syn-196", "source": "synthetic", "source_id": "114", "model": "openrouter-deepseek", "experiment": "few_shot", "markdown_stats": {"n_pages": null, "n_tables": null, "markdown_len": 2042}, "n_gold_tests": 2, "n_predicted_tests": 2, "sections_found": ["preamble", "results"], "few_shot_applied": false, "summarization_stats": {"applied": false, "skip_reason": "flag_off"}, "predicted_tests": [{"test_type": "t", "statistic_value": 3.74, "df1": 245.0, "df2": null, "reported_p": 0.03, "p_equality": "=", "two_tailed": false, "raw_text": "t(245) = 3.74, p = 0.03 (one-tailed)", "textual_interpretation": "the meditation group did not significantly differ from controls", "interpretation_direction": "not_significant", "consistent": true, "notes": "one-tailed independent samples t-test comparing meditation group and controls"}, {"test_type": "F", "statistic_value": 3.93, "df1": 3.0, "df2": 151.0, "reported_p": 0.01, "p_equality": "=", "two_tailed": true, "raw_text": "F(3, 151) = 3.93, p = 0.01", "textual_interpretation": "baseline severity categories did not meaningfully predict treatment outcomes", "interpretation_direction": "significant", "consistent": false, "notes": "one-way ANOVA examining effect of baseline anxiety severity on post-intervention anxiety scores"}], "merged_tests": [{"test_type": "t", "statistic_value": 3.74, "df1": 245.0, "df2": null, "reported_p": 0.03, "p_equality": "=", "two_tailed": false, "raw_text": "t(245) = 3.74, p = 0.03 (one-tailed)", "textual_interpretation": "the meditation group did not significantly differ from controls", "interpretation_direction": "not_significant", "consistent": true, "notes": "one-tailed independent samples t-test comparing meditation group and controls", "interpretations": [{"section": "results", "sentence": "A one-tailed independent samples t-test revealed that the meditation group (M = 28.3, SD = 9.2) did not significantly differ from controls (M = 31.7, SD = 10.1), t(245) = 3.74, p = 0.03 (one-tailed)