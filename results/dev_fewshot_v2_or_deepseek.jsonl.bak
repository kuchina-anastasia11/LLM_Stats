ging": true, "claim": "Post-hoc tests showed minimal differences between severity groups, indicating baseline anxiety level was not a reliable predictor of intervention response."}], "primary_direction": "not_significant", "has_cross_section_conflict": true, "any_hedging": true, "sections": ["results", "results"]}], "verified_tests": [{"test_type": "t", "statistic_value": 3.74, "df1": 245.0, "df2": null, "reported_p": 0.03, "p_equality": "=", "two_tailed": false, "raw_text": "t(245) = 3.74, p = 0.03 (one-tailed)", "textual_interpretation": "the meditation group did not significantly differ from controls", "interpretation_direction": "not_significant", "consistent": true, "notes": "one-tailed independent samples t-test comparing meditation group and controls", "interpretations": [{"section": "results", "sentence": "A one-tailed independent samples t-test revealed that the meditation group (M = 28.3, SD = 9.2) did not significantly differ from controls (M = 31.7, SD = 10.1), t(245) = 3.74, p = 0.03 (one-tailed). Despite the numerical difference favoring the intervention group, these results suggest that mindfulness training had minimal practical impact on anxiety reduction in this sample.", "keywords": ["did not significantly differ", "minimal practical impact"], "direction": "not_significant", "effect_strength": "none", "hedging": true, "claim": "The mindfulness training group did not significantly differ from the control group in reducing social anxiety symptoms, suggesting minimal practical impact."}], "primary_direction": "not_significant", "has_cross_section_conflict": false, "any_hedging": true, "sections": ["results"], "computed_p": 0.0001145919, "p_consistency": "inconsistent", "interpretation_consistency": "inconsistent"}, {"test_type": "F", "statistic_value": 3.93, "df1": 3.0, "df2": 151.0, "reported_p": 0.01, "p_equality": "=", "two_tailed": true, "raw_text": "F(3, 151) = 3.93, p = 0.01", "textual_interpretation": "baseline severity categories did not meani