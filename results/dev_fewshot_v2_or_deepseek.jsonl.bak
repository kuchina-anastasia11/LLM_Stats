{"example_id": "dev-syn-214", "source": "synthetic", "source_id": "217", "model": "openrouter-deepseek", "experiment": "few_shot", "markdown_stats": {"n_pages": null, "n_tables": null, "markdown_len": 1787}, "n_gold_tests": 2, "n_predicted_tests": 2, "sections_found": ["preamble", "results"], "few_shot_applied": false, "summarization_stats": {"applied": false, "skip_reason": "flag_off"}, "predicted_tests": [{"test_type": "chi", "statistic_value": 18.32, "df1": 9.0, "df2": null, "reported_p": 0.168, "p_equality": "=", "two_tailed": true, "raw_text": "χ²(9) = 18.32, p = 0.168", "textual_interpretation": "no significant association between occupational type and primary coping strategy selection", "interpretation_direction": "not_significant", "consistent": true, "notes": "chi-square test of independence for coping strategy preference across occupational categories"}, {"test_type": "r", "statistic_value": -0.07, "df1": 142.0, "df2": null, "reported_p": 0.43, "p_equality": "=", "two_tailed": true, "raw_text": "r(142) = -0.07, p = 0.43", "textual_interpretation": "negligible negative correlation that was not statistically significant", "interpretation_direction": "not_significant", "consistent": true, "notes": "Pearson correlation between years of organizational tenure and self-reported emotional exhaustion scores"}], "merged_tests": [{"test_type": "chi", "statistic_value": 18.32, "df1": 9.0, "df2": null, "reported_p": 0.168, "p_equality": "=", "two_tailed": true, "raw_text": "χ²(9) = 18.32, p = 0.168", "textual_interpretation": "no significant association between occupational type and primary coping strategy selection", "interpretation_direction": "not_significant", "consistent": true, "notes": "chi-square test of independence for coping strategy preference across occupational categories", "interpretations": [{"section": "results", "sentence": "The sample consisted of 144 employed adults (Mage = 38.7 years, SD = 11.2; 58% female) recruited from three organizational secto