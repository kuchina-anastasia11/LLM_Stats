{"example_id": "dev-syn-096", "source": "synthetic", "source_id": "281", "model": "openrouter-deepseek", "experiment": "few_shot", "markdown_stats": {"n_pages": null, "n_tables": null, "markdown_len": 1598}, "n_gold_tests": 2, "n_predicted_tests": 2, "sections_found": ["preamble", "results"], "few_shot_applied": false, "summarization_stats": {"applied": false, "skip_reason": "flag_off"}, "predicted_tests": [{"test_type": "t", "statistic_value": 3.13, "df1": 199.0, "df2": null, "reported_p": 0.002, "p_equality": "=", "two_tailed": true, "raw_text": "t(199) = 3.13, p = 0.002", "textual_interpretation": "indicating a statistically significant difference between groups with a medium effect size (d = 0.62)", "interpretation_direction": "significant", "consistent": true, "notes": "Independent-samples t-test comparing social anxiety symptoms between support community participants and non-participants."}, {"test_type": "chi", "statistic_value": 2.65, "df1": 8.0, "df2": null, "reported_p": 0.98, "p_equality": "=", "two_tailed": true, "raw_text": "χ²(8) = 2.65, p = 0.98", "textual_interpretation": "suggesting that educational background did not meaningfully predict engagement in these online resources", "interpretation_direction": "not_significant", "consistent": true, "notes": "Chi-square test of independence examining the relationship between educational attainment and support community participation."}], "merged_tests": [{"test_type": "t", "statistic_value": 3.13, "df1": 199.0, "df2": null, "reported_p": 0.002, "p_equality": "=", "two_tailed": true, "raw_text": "t(199) = 3.13, p = 0.002", "textual_interpretation": "indicating a statistically significant difference between groups with a medium effect size (d = 0.62)", "interpretation_direction": "significant", "consistent": true, "notes": "Independent-samples t-test comparing social anxiety symptoms between support community participants and non-participants.", "interpretations": [{"section": "results", "sentence": "An independent-samples t-test revealed that individuals who engaged in support communities reported significantly lower social anxiety symptoms (M = 24.3, SD = 8.1) compared to non-participants (M = 29.7, SD = 9.4), t(199) = 3.13, p = 0.002, indicating a statistically significant difference between groups with a medium effect size (d = 0.62).", "keywords": ["significantly lower", "statistically significant", "medium effect size"], "direction": "significant", "effect_strength": "moderate", "hedging": false, "claim": "Individuals who engaged in support communities reported significantly lower social anxiety symptoms compared to non-participants."}], "primary_direction": "significant", "has_cross_section_conflict": false, "any_hedging": false, "sections": ["results"]}, {"test_type": "chi", "statistic_value": 2.65, "df1": 8.0, "df2": null, "reported_p": 0.98, "p_equality": "=", "two_tailed": true, "raw_text": "χ²(8) = 2.65, p = 0.98", "textual_interpretation": "suggesting that educational background did not meaningfully predict engagement in these online resources", "interpretation_direction": "not_significant", "consistent": true, "notes": "Chi-square test of independence examining the relationship between educational attainment and support community participation.", "interpretations": [{"section": "results", "sentence": "The distribution of support community participation was not significantly associated with educational level, χ²(8) = 2.65, p = 0.98, suggesting that educational background did not meaningfully predict engagement in these online resources.", "keywords": ["not significantly associated", "did not meaningfully predict"], "direction": "not_significant", "effect_strength": "none", "hedging": false, "claim": "No significant association was found between educational level and participation in support communities."}, {"section": "results", "sentence": "The non-significant relationship between education and engagement may indicate that online support communities serve