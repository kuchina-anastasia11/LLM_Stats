{"example_id": "dev-syn-011", "source": "synthetic", "source_id": "163", "model": "openrouter-deepseek", "experiment": "few_shot", "markdown_stats": {"n_pages": null, "n_tables": null, "markdown_len": 1697}, "n_gold_tests": 2, "n_predicted_tests": 2, "sections_found": ["preamble", "results"], "few_shot_applied": false, "summarization_stats": {"applied": false, "skip_reason": "flag_off"}, "predicted_tests": [{"test_type": "Q", "statistic_value": 32.53, "df1": 7.0, "df2": null, "reported_p": 0.02, "p_equality": "=", "two_tailed": true, "raw_text": "Q(7) = 32.53, p = 0.02", "textual_interpretation": "study design significantly explained a portion of the between-study variance", "interpretation_direction": "significant", "consistent": true, "notes": "Mixed-effects meta-regression with study design as a categorical moderator"}, {"test_type": "Q", "statistic_value": 48.36, "df1": 14.0, "df2": null, "reported_p": 0.03, "p_equality": "=", "two_tailed": true, "raw_text": "Q(14) = 48.36, p = 0.03", "textual_interpretation": "the combined moderating effects of age group and region were statistically significant", "interpretation_direction": "significant", "consistent": true, "notes": "Two-way subgroup analysis across 15 effect size estimates"}], "merged_tests": [{"test_type": "Q", "statistic_value": 32.53, "df1": 7.0, "df2": null, "reported_p": 0.02, "p_equality": "=", "two_tailed": true, "raw_text": "Q(7) = 32.53, p = 0.02", "textual_interpretation": "study design significantly explained a portion of the between-study variance", "interpretation_direction": "significant", "consistent": true, "notes": "Mixed-effects meta-regression with study design as a categorical moderator", "interpretations": [{"section": "results", "sentence": "Initial heterogeneity testing revealed substantial variability in effect sizes across studies (I² = 67%). To investigate whether study design (randomized controlled trial, quasi-experimental, or observational) moderated the overall effect, we performed a mixed-effects meta-regression with study design as a categorical moderator; this analysis yielded Q(7) = 32.53, p = 0.02, indicating that study design significantly explained a portion of the between-study variance.", "keywords": ["significantly"], "direction": "significant", "effect_strength": "moderate", "hedging": false, "claim": "Study design significantly explained a portion of the between-study variance."}], "primary_direction": "significant", "has_cross_section_conflict": false, "any_hedging": false, "sections": ["results"]}, {"test_type": "Q", "statistic_value": 48.36, "df1": 14.0, "df2": null, "reported_p": 0.03, "p_equality": "=", "two_tailed": true, "raw_text": "Q(14) = 48.36, p = 0.03", "textual_interpretation": "the combined moderating effects of age group and region were statistically significant", "interpretation_direction": "significant", "consistent": true, "notes": "Two-way subgroup analysis across 15 effect size estimates", "interpretations": [{"section": "results", "sentence": "Subsequently, we examined whether the relationship between daily screen time (measured in hours) and Beck Depression Inventory scores differed as a function of both participant age group (adolescents aged 13–15 vs. 16–18) and geographic region (North America, Europe, Asia, and Australia), conducting a two-way subgroup analysis across 15 effect size estimates; this analysis produced Q(14) = 48.36, p = 0.03, suggesting that the combined moderating effects of age group and region were statistically significant.", "keywords": ["statistically significant"], "direction": "significant", "effect_strength": "moderate", "hedging": false, "claim": "The combined moderating effects of age group and region were statistically significant."}], "primary_direction": "significant", "has_cross_section_conflict": false, "any_hedging": false, "sections": ["results"]}], "verified_tests": [{"test_type": "Q", "statistic_value": 32.53, "df1": 7.0, "df2": null, "reported_p": 0.02, "p_equality"